{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "backend": {
      "root": "apps/api",
      "framework": "hono",
      "entrypoint": "src/vercel.ts",
      "functions": {
        "src/vercel.ts": { "maxDuration": 60 }
      }
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "backend" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}

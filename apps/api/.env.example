NODE_ENV=development
DATABASE_URL=
RESEND_API_KEY=
# Bare sender address. Development only: Resend's test sender is restricted.
# Production: replace with an address on your Resend-verified domain.
EMAIL_FROM=onboarding@resend.dev
# EMAIL_FROM=security@mail.your-domain.example
# Override NODE_ENV=production in the API deployment environment.

# Development defaults; use HTTPS web origin and NODE_ENV=production in deployment.
WEB_ORIGIN=http://localhost:3000
# Exact extension origins only. This ID matches the bundled public development key.
EXTENSION_ORIGINS=chrome-extension://aeklikmljjjbhgmhofhhmbimkmeajigp

# Empty by default: trust the connection IP, not client-supplied forwarding headers.
# For a reverse proxy, list exact immediate peer IPs (including IPv4-mapped IPv6
# where applicable). It MUST overwrite X-Forwarded-For with ONE validated IP.
TRUSTED_PROXY_IPS=

# Arcjet is server-only. Local dev defaults to OFF; production requires LIVE.
# Upgrade Node to 22.21+ (22.x), or 24.5+; see package.json engines.
# For staging observation use DRY_RUN, then verify LIVE denials before launch.
ARCJET_MODE=OFF
# Obtain a site key from https://app.arcjet.com (keep separate dev/prod sites).
ARCJET_KEY=
# Random 32-byte hex HMAC key, stable across restarts/instances, distinct from MFA.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Store privately; rotating this resets distributed rate-limit identities.
ARCJET_IDENTITY_KEY=
# Do not set ARCJET_ENV=development in production; production startup rejects it.
# Never put these secrets in NEXT_PUBLIC_* or VITE_* variables.

# Server-only 32-byte AES key encoded as 64 hex characters. Back up securely.
# Never rotate without re-encrypting enrolled MFA records. Never expose publicly.
MFA_ENCRYPTION_KEY=

# Private persistent directory for logout-revocation retries; required volume in deployment.
# Single API instance only until a deliberately shared revocation backend is added.
SECURITY_STATE_DIR=.security-state
